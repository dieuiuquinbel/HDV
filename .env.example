# Application Environment Configuration (Template)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_USER=sport_user
MYSQL_PASSWORD=your_mysql_user_password

# JWT Configuration (Min 256-bit secret key)
JWT_SECRET=your_jwt_secret_64_characters_hex_string_here_example_only
JWT_EXPIRATION_MINUTES=30

# Internal API Key for inter-service communication
INTERNAL_API_KEY=your_internal_api_key_for_microservices

# Email & SMTP Configuration (Gửi mã OTP xác minh tài khoản)
# Nếu để trống mật khẩu hoặc cấu hình sai, hệ thống sẽ tự động in OTP ra Console Log để test
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Gateway & Service URLs
GATEWAY_PORT=8080
USER_SERVICE_URL=http://localhost:8081
COURT_SERVICE_URL=http://localhost:8082
BOOKING_SERVICE_URL=http://localhost:8083
PAYMENT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
FRONTEND_URL=http://localhost:5173
